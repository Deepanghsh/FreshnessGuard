{
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "plugins": [
    {
      "name": "freshnessguard",
      "path": "/app/plugins/freshnessguard.so",
      "enabled": true,
      "config": {
        "service_url": "http://server:3001",
        "timeout_ms": 2000,
        "basic_mode": false,
        "append_note": true
      }
    }
  ],
  "providers": [
    {
      "name": "openai",
      "type": "openai",
      "api_key": "${OPENAI_API_KEY}",
      "models": [
        "gpt-4o",
        "gpt-4o-mini",
        "gpt-4-turbo"
      ]
    }
  ]
}

