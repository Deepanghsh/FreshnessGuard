{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "source_of_truth": "config.json",
  "client": {
    "enable_logging": true,
    "enforce_auth_on_inference": false
  },
  "auth_config": {
    "is_enabled": true,
    "admin_username": {
      "value": "admin"
    },
    "admin_password": {
      "value": "env.BIFROST_ADMIN_PASSWORD"
    }
  },
  "setup_token": {
    "value": "env.BIFROST_SETUP_TOKEN"
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    }
  },
  "plugins": [
    {
      "name": "freshnessguard",
      "enabled": true,
      "path": "/app/plugins/freshnessguard.so",
      "config": {
        "service_url": "http://server:3001",
        "timeout_ms": 45000,
        "basic_mode": false,
        "inject_note": true
      }
    }
  ]
}