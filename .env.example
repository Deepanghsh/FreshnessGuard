# ==============================================================================
# FreshnessGuard Environment Variables (.env)
# Copy this file to .env before starting the Docker Compose stack or local services
# ==============================================================================

# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LLM_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://client:80

# ─── Verification Mode ──────────────────────────────────────────────────────
# Default mode for requests without an explicit 'mode' field:
# inline  — Verify all claims with Tavily before returning (default)
# async   — Accept immediately (202), stream results via SSE in background
# basic   — Local regex & volatility heuristics only (no external calls)
# bypass  — Pass-through mode, skips FreshnessGuard processing
FRESHNESSGUARD_MODE=inline

# ─── Database Configuration ─────────────────────────────────────────────────
# For Docker Compose: mongodb://mongodb:27017/freshnessguard
# For standalone local run: mongodb://localhost:27017/freshnessguard
MONGODB_URI=mongodb://mongodb:27017/freshnessguard

# ─── Tavily Search API Key (Required for live web verification) ──────────────
# Obtain your key at: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ─── LLM Provider Configuration ─────────────────────────────────────────────
# Used for claim extraction. Falls back gracefully to regex if key is omitted.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Bifrost Gateway Configuration ──────────────────────────────────────────
BIFROST_HOST=http://bifrost:8080
BIFROST_ENCRYPTION_KEY=freshnessguardsecretkey1234567890

# ─── Security & Authentication Boundary ──────────────────────────────────────
# Optional API key to protect POST /api/check and POST /api/verify/:id
FRESHNESSGUARD_API_KEY=

# ─── Rate Limiting & Safety ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_CHECK_MAX=60

# ─── Cache Memory Bounds ─────────────────────────────────────────────────────
CACHE_MAX_ENTRIES=1000
