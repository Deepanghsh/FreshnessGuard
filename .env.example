# ==============================================================================
# FreshnessGuard Environment Variables
# Copy this file to .env before starting the stack
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production
STALEGUARD_MODE=inline
LLM_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/freshnessguard

# Tavily Search API Key (Required for live web verification)
# Get a key at: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# LLM Provider Configuration (OpenAI or Bifrost OpenAI-compatible proxy)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Bifrost Gateway Configuration (Optional, when running through Bifrost gateway)
BIFROST_HOST=http://localhost:8080
BIFROST_ENCRYPTION_KEY=freshnessguardsecretkey1234567890

# Rate Limiting & Safety
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

