# ==============================================================================
# FreshnessGuard Server Environment Variables Reference (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# MongoDB URI (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/freshnessguard
MONGO_TEST_URI=mongodb://localhost:27017/freshnessguard_test

# Tavily Live Search API Key
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Google Gemini API Key (Sole LLM Provider: answer generation & structured claim extraction)
GEMINI_API_KEY=your-gemini-api-key-here

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Secret (HMAC-SHA256 cookie signing)
SESSION_SECRET=freshnessguard_super_secret_session_key_2026
