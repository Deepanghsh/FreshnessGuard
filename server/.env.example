# ==============================================================================
# FreshnessGuard Server Environment Variables (.env)
# ==============================================================================

PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/freshnessguard

# Tavily Search API Key
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# LLM Provider Key & Base URL
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Operating mode: "inline" (blocks until verified) or "async" (returns immediately with unverified, verifies in background)
STALEGUARD_MODE=inline

# LLM Model used for claim extraction
LLM_MODEL=gpt-4o-mini

# CORS allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
