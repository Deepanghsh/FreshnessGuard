# ==============================================================================
# FreshnessGuard Server Environment Variables (.env)
# ==============================================================================

PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/freshnessguard
MONGO_TEST_URI=mongodb://localhost:27017/freshnessguard_test

# Tavily Search API Key
# Get yours at: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# LLM Provider Key & Base URL
# When using Bifrost Gateway, set OPENAI_BASE_URL to Bifrost's OpenAI-compatible endpoint.
# FreshnessGuard sends x-bf-eh-freshnessguard-bypass: true on internal LLM calls to prevent recursion.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Operating Mode ─────────────────────────────────────────────────────────
# Controls default verification behaviour when no per-request `mode` field is provided.
#
# inline  — Block response until all claims are verified via Tavily (default)
# async   — Return 202 immediately; verify in background and push SSE updates
# basic   — Lightweight local heuristic only; zero Tavily/external calls
# bypass  — Skip FreshnessGuard entirely (always overrides other settings)
#
# Per-request `mode` field in POST /api/check always overrides this env variable.
# The x-freshnessguard-bypass and x-bf-eh-freshnessguard-bypass headers also
# trigger bypass regardless of this setting (used for internal LLM calls).
FRESHNESSGUARD_MODE=inline

# LLM Model used for claim extraction (regex fallback is used when no OPENAI_API_KEY)
LLM_MODEL=gpt-4o-mini

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Security & Authentication Boundary ──────────────────────────────────────
# Optional API key to enforce on mutating endpoints (POST /api/check, POST /api/verify/:id).
# When set, callers must provide 'Authorization: Bearer <key>' or 'X-FreshnessGuard-Key: <key>'.
# Leave empty or omitted in local development/demo environments to disable authentication.
FRESHNESSGUARD_API_KEY=

# ─── Rate Limiting (HTTP tier) ───────────────────────────────────────────────
# Controls inbound requests to the FreshnessGuard server via express-rate-limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_CHECK_MAX=60

# ─── Cache Memory Bounds ─────────────────────────────────────────────────────
# Maximum entries in the L1 in-memory LRU cache before oldest entries are evicted.
CACHE_MAX_ENTRIES=1000

# ─── Tavily Internal Rate Limiter ────────────────────────────────────────────
# The Tavily token-bucket in verification.ts limits outbound API calls to
# 10 requests/minute per Node.js process (single-instance safe).
# For multi-instance deployments (Kubernetes replicas, PM2 clusters), replace
# with a Redis-backed distributed rate limiter to enforce a cluster-wide limit.
# TAVILY_RATE_LIMIT_PER_MINUTE=10  (hardcoded in verification.ts, see docs)
