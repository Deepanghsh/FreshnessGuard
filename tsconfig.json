{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./server/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "eval/**/*"
  ],
  "exclude": [
    "node_modules",
    "client",
    "server"
  ]
}
